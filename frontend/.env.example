# Google sign-in client ID (from Google Cloud Console > Credentials)
# Get this from your backend teammate, or create your own OAuth client at
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# --- Only needed for a real deployment, not local development ---
# In development, vite.config.js proxies /api, /socket.io, and /yjs to
# localhost:5000 automatically, so these three can stay blank.
# VITE_API_URL=https://api.yoursite.com/api
# VITE_SOCKET_URL=https://api.yoursite.com
# VITE_WS_URL=wss://api.yoursite.com/yjs