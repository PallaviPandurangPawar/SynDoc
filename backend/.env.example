PORT=5000
CLIENT_URL=http://localhost:5173

# Your MongoDB Atlas connection string
MONGO_URI=

# Any long random string (used to sign login tokens)
JWT_SECRET=

# Gmail account that sends the OTP emails
EMAIL_USER=

# 16-character Google App Password (no spaces)
EMAIL_PASS=

# Google sign-in (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=