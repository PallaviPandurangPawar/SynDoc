PORT=5000

# The website address(es) allowed to call this API. Separate several with commas.
# In production, set this to your real site address and also set NODE_ENV=production
CLIENT_URL=http://localhost:5173

# MongoDB connection string (Atlas or Local)
MONGO_URI=mongodb://127.0.0.1:27017/syncdoc

# A long random string (at least 32 characters) used to sign login tokens.
# The server will not start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Gmail account that sends the OTP emails
EMAIL_USER=

# 16-character Google App Password (no spaces)
EMAIL_PASS=

# Google sign-in (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=